# Upstash: Database → Connect → "ioredis" tab (TLS URL)
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# OpenF1 sponsor account (live data, and REST while a session is live). Leave empty for past sessions only.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Team radio transcripts: three speech-to-text models, then Gemini settles what was said. Any left empty is skipped.
ELEVENLABS_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
